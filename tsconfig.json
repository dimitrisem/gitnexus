{
  "compilerOptions": {
    "baseUrl": "./src",
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "ESNext"],
    "esModuleInterop": true,
    "sourceMap": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "outDir": "dist",
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "declaration": false,
    "paths": {
			/* Own... */
      "@/*":           					 ["*"],
			"@main/*":     	 					 ["main/*"],
			"@fonts/*":      					 ["assets/fonts/*"],
      "@imgs/*":       					 ["assets/imgs/*"],
			"@constants/lordicon/*":	 ["assets/lordicon/*"],
      "@scss/*":       					 ["assets/scss/*"],
      "@constants/*":  					 ["constants/*"],
      "@components/*": 					 ["components/*"],
			"@hooks/*": 					 		 ["hooks/*"],
			"@style/*": 					     ["style/*"],
			"@pages/*": 						   ["pages/*"],
			"@routes/*": 					 		 ["routes/*"],
			"@utils":      					   ["utils/index.ts"],
      "@helpers/*":    					 ["helpers/*"],
      "@store/*": 		 					 ["store/*"],
      "@mocks/*": 		 					 ["__mocks__/*"],
      "@typeDefs":  	 					 ["typeDefs.ts"],
			/* Vendor... */
			"src/*":       					    ["vendor/MuiMinimal/*"],
			"@vendor/MuiMinimal/*":     ["vendor/MuiMinimal/*"],
			"@MuiMinimal/components/*": ["vendor/MuiMinimal/components/*"],
			"@MuiMinimal/theme/*": 		  ["vendor/MuiMinimal/theme/*"],
    },
		"skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "resolveJsonModule": true,
    "isolatedModules": false
  },
  "include": ["./src/**/*", "./configs/webpack/*", "stylelint.config.ts", ".eslintrc.js", "index.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "webpack",
    "jest",
    "src/setupTests.ts",
    "**/*/*.test.ts",
		"src/vendor/**",
		"quokka.ts"
  ]
}